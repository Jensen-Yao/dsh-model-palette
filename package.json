{
  "name": "dsh-model-palette",
  "version": "0.10.2",
  "description": "Global model command palette and provider/model configuration panel for DeepSeek Harness, with selective request retries, OpenRouter free-model import, loopback relays, online capacity presets, and optional media tools.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "docs",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "model-selector",
    "command-palette",
    "provider",
    "request-retry",
    "openrouter",
    "image-generation",
    "video-generation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jensen-Yao/dsh-model-palette.git"
  },
  "bugs": {
    "url": "https://github.com/Jensen-Yao/dsh-model-palette/issues"
  },
  "homepage": "https://github.com/Jensen-Yao/dsh-model-palette#readme",
  "engines": {
    "node": ">=22.19"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.2-alpha.3 <0.2.0-0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.2-alpha.3 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-model-selection": ">=0.1.2-alpha.3 <0.2.0-0",
    "@deepseek-ai/dsh-settings": ">=0.1.2-alpha.3 <0.2.0-0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "pack:release": "pnpm pack --pack-destination release"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-api-remotes": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-api-session-controller": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-api-settings-controller": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-locale": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-model-selection": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-settings": "0.1.2-alpha.3",
    "@types/node": "^22.19.7",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "lightningcss": "^1.32.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@11.21.0"
}
